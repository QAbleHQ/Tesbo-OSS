# Copy to .env and adjust for non-local targets. Every value has a sensible default for
# the local docker-compose stack, so this file is optional for local runs.

API_BASE_URL=http://localhost:1011
WEB_BASE_URL=http://localhost:1010

# The domain every address this suite invents lives at. Keep it a real, mail-accepting domain.
#
# What actually keeps a run from bouncing mail is the backend: it only delivers when explicitly set
# to EMAIL_DELIVERY_MODE=live against a Live Postmark server. Local and CI stacks leave that at the
# default "log" and point POSTMARK_API_TOKEN at a Postmark SANDBOX server, so OTPs are printed to
# the backend log and other emails are accepted-but-never-delivered. api/email-delivery.spec.ts
# fails the run if the stack under test could reach real mailboxes.
#
# mailinator.com stays the default as a second line of defence (and it accepts everything without
# bouncing) — this used to default to `tesbo.local`, which does not exist, and ~1100 bounces off it
# got the Postmark sending account flagged.
E2E_EMAIL_DOMAIN=mailinator.com

# Disposable smoke-test account. On a fresh stack this user doesn't exist yet — global
# setup creates it automatically (see E2E_AUTO_PROVISION below).
E2E_TEST_EMAIL=e2e-smoke@mailinator.com
E2E_TEST_PASSWORD=E2eSmokeTest!2026
E2E_TEST_NAME=E2E Smoke User

E2E_ORG_NAME=E2E Smoke Org
E2E_PROJECT_NAME=E2E Smoke Project

# Second, independent tenant used only by e2e/api/authorization.spec.ts (the cross-tenant
# authorization regression suite) to prove account B can't reach account A's resources.
E2E_TEST_EMAIL_B=e2e-smoke-b@mailinator.com
E2E_TEST_PASSWORD_B=E2eSmokeTestB!2026
E2E_TEST_NAME_B=E2E Smoke User B
E2E_ORG_NAME_B=E2E Smoke Org B
E2E_PROJECT_NAME_B=E2E Smoke Project B

# Disposable tenant for e2e/api/workspaces.spec.ts (the duplicate-workspace-name regression
# suite). It needs an account of its own because POST /api/workspaces repoints the caller's
# ACTIVE workspace, and it tears its workspaces down through psql — so that suite skips
# entirely when docker isn't reachable rather than leaving them behind.
E2E_WORKSPACES_EMAIL=e2e-workspaces@mailinator.com
E2E_WORKSPACES_PASSWORD=E2eWorkspaces!2026
E2E_WORKSPACES_NAME=E2E Workspaces User
E2E_WORKSPACES_ORG_NAME=E2E Workspaces Org
E2E_WORKSPACES_PROJECT_NAME=E2E Workspaces Project

# Defaults to true when API_BASE_URL is localhost/127.0.0.1, false otherwise. Signup
# requires an OTP that (with no Postmark token configured) is only printed to the backend
# container's stdout, so auto-provisioning scrapes it from `docker compose logs`. Against a
# remote target, either pre-create E2E_TEST_EMAIL/E2E_TEST_PASSWORD yourself and leave this
# false, or set it to true only if you also have docker log access to that host.
E2E_AUTO_PROVISION=

E2E_DOCKER_COMPOSE_FILE=
E2E_DOCKER_SERVICE=backend

# ── Reporting this suite's results back into Tesbo ────────────────────────────────────────────────
#
# The reporter registered in playwright.config.ts needs three values. Two of them are not secrets and
# are committed in that config (the API host :1021 and the project UUID). The third is:
#
#   TESBO_API_TOKEN   a project API token from Project -> Settings -> API & MCP, `read` + `write`
#
# It must be in the PROCESS ENVIRONMENT — nothing reads e2e/.env, so a value written here is never
# picked up. Either export it for the run:
#
#     export TESBO_API_TOKEN=tsbo_...
#
# or, when aiming the suite at an environment with E2E_ENV, put it in that (gitignored) environment
# file: e2e/environments/local.env or stage.env. process.env always wins over the file, so a CI job
# injects it as a credential instead.
#
# With the token unset the reporter warns once and reports nothing; the suite still runs and passes.
# Never commit the value — this file is tracked.
TESBO_API_TOKEN=
