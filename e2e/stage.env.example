# Copy to e2e/stage.env (gitignored) and fill in. Consumed by scripts/e2e-stage.sh.
#
# This file exists because a stage run differs from a local run in exactly three ways:
#   1. it cannot read the backend's stdout, so signup OTPs are unreachable  -> tenants must pre-exist
#   2. it cannot reach the stack's Postgres by default                      -> DB-fixture specs skip
#   3. it is shared infrastructure other people are using                   -> nothing destructive
# Everything else — specs, assertions, helpers — is identical to the local run.

API_BASE_URL=https://api-app-stage.tesbo.io
WEB_BASE_URL=https://app-stage.tesbo.io

# --- REQUIRED: tenants that already exist on stage -------------------------------------------
#
# global-setup.ts hard-fails the whole run if it cannot log in as account A or account B, and on a
# remote target it has no way to create them: /api/auth/signup/start sends the OTP as a real email,
# and the DB-seed fallback needs the stage database. So both must be created by hand on stage first
# (sign up through https://app-stage.tesbo.io/signup once, complete onboarding, then put the
# credentials here). Account B exists only so api/authorization.spec.ts can prove account B cannot
# reach account A's data — it must be a genuinely separate workspace, not a member of A's.
#
# Give account A a workspace whose plan is unrestricted, and let it own a project named exactly
# E2E_PROJECT_NAME — global-setup finds the fixture project by name and creates it if absent.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_ORG_NAME=E2E Smoke Org
E2E_PROJECT_NAME=E2E Smoke Project

E2E_TEST_EMAIL_B=
E2E_TEST_PASSWORD_B=
E2E_ORG_NAME_B=E2E Smoke Org B
E2E_PROJECT_NAME_B=E2E Smoke Project B

# --- OPTIONAL: the four disposable tenants ----------------------------------------------------
#
# billing-api, billing-ui, workspaces and screens. Each one is destructive to its own workspace, so
# they never share account A's. They are provisioned optionally: leave these blank and the suites
# that own them skip cleanly instead of failing the run. Note the screens tenant additionally needs
# a Pro plan (global-setup normally writes that straight into Postgres), so without stage DB access
# it will be on Launch and its suites will hit the 2-project limit — leave it blank unless someone
# has put that account on Pro by hand.
E2E_BILLING_API_EMAIL=
E2E_BILLING_API_PASSWORD=
E2E_BILLING_UI_EMAIL=
E2E_BILLING_UI_PASSWORD=
E2E_WORKSPACES_EMAIL=
E2E_WORKSPACES_PASSWORD=
E2E_SCREENS_EMAIL=
E2E_SCREENS_PASSWORD=

# --- OPTIONAL: stage database access ----------------------------------------------------------
#
# Unset (the default) is the safe mode: utils/psql.ts refuses to guess a database, dbControlAvailable()
# returns false, and every spec that arranges state through SQL skips itself. That is ~29 spec files.
#
# Setting this to stage's own DATABASE_URL unlocks them — the psql helper only uses the local
# postgres container as transport for the psql binary, so a hosted stage URL is reachable from here.
# It also means those specs will INSERT, UPDATE and DELETE rows in the stage database (seeding OTP
# codes, clearing rate-limit buckets, rewriting plan columns, deleting fixture tenants). Scoped to
# their own disposable tenants, but real writes to shared infrastructure all the same, so
# scripts/e2e-stage.sh additionally requires E2E_STAGE_DB_WRITES_ACK=yes before it will start.
E2E_DATABASE_URL=
E2E_STAGE_DB_WRITES_ACK=

# --- Never enable against stage ---------------------------------------------------------------
# Real Stripe writes: a Checkout Session against a live key creates a real Customer and permanently
# pins that workspace's billing currency. scripts/e2e-stage.sh refuses to run if this is true.
E2E_BILLING_ALLOW_STRIPE_WRITES=false
