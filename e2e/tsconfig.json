{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is needed for the code that runs INSIDE page.evaluate() — the theme sweep audits
    // computed styles in the browser, where document/window/getComputedStyle are real.
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"]
  },
  "exclude": ["node_modules", "test-results", "playwright-report"]
}
